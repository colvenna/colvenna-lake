    "type": "prometheus",
    "uid": "colvenna-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": "__TARGET_LAYER_P95__"
       },
       {
        "color": "red",
        "value": "__TARGET_LAYER_P99__"
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "quantile_over_time(0.95, colvenna_source_latency_seconds[30m])",
     "legendFormat": "p95 {{source}}"
